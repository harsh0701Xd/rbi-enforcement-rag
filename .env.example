# FinGraph Intelligence System — Environment Variables
# Copy this file to .env and fill in the values.
# .env is gitignored. Never commit secrets.

# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Neo4j ─────────────────────────────────────────────────────────────────────
# Local dev (Docker): bolt://localhost:7687
# Production (Neo4j Aura Free): bolt+s://xxxxx.databases.neo4j.io
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# ── PostgreSQL (LangGraph checkpointer) ───────────────────────────────────────
PG_HOST=localhost
PG_PORT=5433
PG_DB=langgraph_state
PG_USER=fingraph
PG_PASSWORD=

# ── LangSmith ─────────────────────────────────────────────────────────────────
LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=fingraph-intelligence

# ── MLflow ────────────────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://localhost:5000

# ── Embedding Provider Connections ───────────────────────────────────────────
# Only the active provider (set via embedding.provider in config.yaml) needs values.
# Ollama
OLLAMA_BASE_URL=http://localhost:11434
# OpenAI
OPENAI_API_KEY=
# Cohere
COHERE_API_KEY=
# HuggingFace (local — no key needed; set device in config.yaml)
# VoyageAI
VOYAGEAI_API_KEY=
# Mistral
MISTRAL_API_KEY=

# ── ChromaDB ──────────────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./data/chroma

# ── Evaluation ────────────────────────────────────────────────────────────────
# NEVER set RAGAS_JUDGE_MODEL to the same value as SYSTEM_MODEL — circular bias
RAGAS_JUDGE_MODEL=claude-sonnet-4-5
SYSTEM_MODEL=claude-haiku-4-5-20251001
